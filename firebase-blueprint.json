{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile details registered in TrailMind AI",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the authenticated user"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Explorer call-sign or user full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Optional profile photo or avatar URL"
        },
        "experienceLevel": {
          "type": "string",
          "description": "Trail explorer experience level",
          "enum": ["Novice Explorer", "Seasoned Rambler", "Trail Master"]
        },
        "preferredBiome": {
          "type": "string",
          "description": "Default biome or favorite environment"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login"
        },
        "totalAdventures": {
          "type": "number",
          "description": "Number of completed micro-adventures"
        },
        "totalOutdoorMinutes": {
          "type": "number",
          "description": "Total logged outdoor minutes"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user personal profile and synchronized outdoor statistics"
    }
  }
}
