# TrailMind AI Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# -------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (BROWSER SAFE)
# -------------------------------------------------------------
# Public client configuration for Firebase Web SDK.
# Protected via Firebase Console Authorized Domains, App Check, and Firestore Rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -------------------------------------------------------------
# 2. LOCAL OPEN-SOURCE AI (OLLAMA - SERVER SIDE ONLY)
# -------------------------------------------------------------
# The browser/frontend NEVER communicates directly with Ollama.
# Only the server-side AI provider communicates with Ollama.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# -------------------------------------------------------------
# 3. CLOUD AI (GOOGLE GEMINI - SERVER SIDE ONLY)
# -------------------------------------------------------------
# SERVER-SIDE ONLY. NEVER prefix with VITE_ or expose to the frontend.
# In Google AI Studio, injected automatically via user secrets.
GEMINI_API_KEY=""

# -------------------------------------------------------------
# 4. RUNTIME APP SETTINGS
# -------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
