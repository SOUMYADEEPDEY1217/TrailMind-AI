# TrailMind AI Environment Configuration

# -------------------------------------------------------------
# 1. LOCAL OPEN-SOURCE AI (OLLAMA - SERVER SIDE ONLY)
# -------------------------------------------------------------
# The browser/frontend NEVER communicates directly with Ollama.
# Only the server-side AI provider communicates with Ollama.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# -------------------------------------------------------------
# 2. CLOUD AI (GOOGLE GEMINI)
# -------------------------------------------------------------
# Optional. Used when explicitly configured or selected in settings.
# In Google AI Studio, injected automatically via user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# -------------------------------------------------------------
# 3. RUNTIME APP SETTINGS
# -------------------------------------------------------------
PORT=3000
APP_URL="MY_APP_URL"
